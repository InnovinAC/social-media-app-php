{
    "name": "innovin/phpvin",
    "description": "A small server-rendered PHP framework. Explicit wiring, no facades, no globals \u2014 small enough to read in one sitting.",
    "type": "library",
    "keywords": [
        "framework",
        "router",
        "mvc",
        "active-record",
        "twig",
        "psr-11",
        "jquery",
        "ujs"
    ],
    "homepage": "https://github.com/innovin/phpvin",
    "license": "MIT",
    "authors": [
        {
            "name": "innovin",
            "email": "innovinanuonye@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "symfony/var-dumper": "^7.0",
        "twig/twig": "^3.10"
    },
    "suggest": {
        "twig/twig": "For the Twig view engine. Not needed for the php or html engines, or for an API-only app.",
        "vlucas/phpdotenv": "To load configuration from a .env file."
    },
    "autoload": {
        "psr-4": {
            "Phpvin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phpvin\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --memory-limit=512M",
        "style": "php-cs-fixer fix --dry-run --diff",
        "style:fix": "php-cs-fixer fix",
        "check": [
            "@style",
            "@analyse",
            "@test"
        ],
        "test:mysql": "DB_DRIVER=mysql phpunit",
        "test:pgsql": "DB_DRIVER=pgsql phpunit",
        "test:drivers": [
            "@test",
            "@test:mysql",
            "@test:pgsql"
        ],
        "mutate": "bin/mutate",
        "mutate:drivers": "bin/mutate --drivers=sqlite,mysql,pgsql",
        "bench": "bin/bench"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.1.x-dev",
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "test:drivers": "Run the suite against SQLite, MySQL and Postgres (needs `make db-up`).",
        "check": "Everything CI runs on a single driver.",
        "mutate": "Break the source one edit at a time and check the suite notices.",
        "bench": "Measure routing, container and request throughput."
    }
}
