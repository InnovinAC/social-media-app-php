# Copy to .env and adjust. Never commit .env.

APP_DEBUG=true
APP_URL=http://localhost:8000

# Leave empty for relative asset paths, which work on any host and port.
# Set it only when assets live on a CDN.
ASSET_URL=

# Views: twig | php | html | none
VIEW_ENGINE=twig

# Defaults to a SQLite file, so this runs with nothing installed.
DB_DRIVER=sqlite
DB_DATABASE=

# For MySQL or Postgres instead:
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=phpvin
# DB_USERNAME=root
# DB_PASSWORD=
