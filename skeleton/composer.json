{
    "name": "innovin/phpvin-skeleton",
    "description": "Starting point for a phpvin application.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "innovin/phpvin": "^0.1",
        "twig/twig": "^3.10",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public",
        "migrate": "php database/migrate.php",
        "test": "phpunit"
    },
    "repositories": [
        {
            "comment": "Resolves innovin/phpvin from the checkout next door, so edits to the framework are live here. Delete this block to install the published package from Packagist instead.",
            "type": "path",
            "url": "../",
            "options": {
                "symlink": true,
                "versions": {
                    "innovin/phpvin": "0.1.x-dev"
                }
            }
        }
    ],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    }
}
